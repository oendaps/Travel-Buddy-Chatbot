# ---------------------------------------------------------------------------
# Salin file ini menjadi .env lalu isi nilainya.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# WAJIB — ambil API key di https://aistudio.google.com/apikey
GEMINI_API_KEY=your_credential_key

# Model default. Cek model yang tersedia dengan `npm run check`
# atau lewat GET /api/models.
GEMINI_MODEL=gemini-2.5-flash

# Batas panjang jawaban model.
GEMINI_MAX_OUTPUT_TOKENS=4096

# Jumlah pesan terakhir yang dikirim ulang sebagai konteks percakapan.
# Makin besar = bot ingat lebih panjang, tapi biaya token naik.
MAX_HISTORY_MESSAGES=20

# Batas ukuran lampiran. Di Render free tier diturunkan ke 8 lewat render.yaml
# karena instance-nya cuma 512MB.
MAX_FILE_MB=20

PORT=3000
