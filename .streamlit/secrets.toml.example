# Contoh file secrets. JANGAN isi API key asli di file ini.
#
# Menjalankan lokal:
#   1. Salin file ini jadi .streamlit/secrets.toml
#   2. Isi API key aslinya di sana
#   File .streamlit/secrets.toml sudah masuk .gitignore.
#
# Deploy di Streamlit Community Cloud:
#   Buka app -> menu titik tiga -> Settings -> Secrets -> tempel baris di bawah.
#   Nilainya disimpan di server Streamlit, bukan di dalam repo.
#
# Ambil API key gratis di https://aistudio.google.com -> Get API Key

GEMINI_API_KEY = "isi-api-key-google-ai-studio-kamu-di-sini"
